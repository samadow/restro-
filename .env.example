# Copy this file to .env and fill values
SECRET_KEY=change-me-to-long-random-string
DEBUG=False
ALLOWED_HOSTS=restora.example.com
CSRF_TRUSTED_ORIGINS=https://restora.example.com
TIME_ZONE=Asia/Dushanbe
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO

# PostgreSQL (empty DB_NAME = sqlite)
DB_NAME=restora
DB_USER=restora
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# AI (Groq) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_RATE=30/hour
